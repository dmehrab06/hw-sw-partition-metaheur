"/people/dass304/.conda/envs/combopt/bin/python" - <<'PY' "/people/dass304/dass304/HWSWpartition/hw-sw-partition-metaheur/BatchExperiments/squeezenet_area_sweep/mip_csv_fragments" "/people/dass304/dass304/HWSWpartition/hw-sw-partition-metaheur/BatchExperiments/squeezenet_area_sweep/mip_squeezenet_area_sweep_10seed-result-summary-soda-graphs-config.csv"
from pathlib import Path
import sys
import pandas as pd

frag_dir = Path(sys.argv[1])
out_csv = Path(sys.argv[2])
paths = sorted(frag_dir.glob("*.csv"))
frames = []
for path in paths:
    try:
        frame = pd.read_csv(path)
    except Exception:
        continue
    if frame.empty:
        continue
    frames.append(frame)

if not frames:
    raise SystemExit(0)

merged = pd.concat(frames, ignore_index=True)
dedupe_cols = [
    col for col in [
        "Config",
        "GraphName",
        "Seed",
        "Area_Percentage",
        "HW_Scale_Factor",
        "HW_Scale_Var",
        "Comm_Scale_Var",
    ] if col in merged.columns
]
if dedupe_cols:
    merged = merged.drop_duplicates(subset=dedupe_cols, keep="last")
merged.to_csv(out_csv, index=False)
print(f"Wrote merged MIP CSV to {out_csv}")
PY
